# Render PostgreSQL External Database URL #URL 뒤에 ?sslmode=require 를 반드시 붙여주세요.
# Render에 배포한 백엔드에서 접속할 때는 Internal Database URL을 사용하세요.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# 로컬 개발용. Render 배포 시에는 PORT를 자동으로 주입하므로 설정하지 않아도 됩니다.
PORT=3000

# 배포된 프론트엔드 주소. 미설정 시 모든 도메인 허용(*)으로 동작합니다.
CORS_ORIGIN="http://localhost:5173"

